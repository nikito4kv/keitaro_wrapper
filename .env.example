# Copy this file to .env and fill in your own values.

# Address of your Keitaro tracker. The /admin_api/v1 suffix is optional: both forms work.
# To try the app without a real tracker, run `python scripts/fake_keitaro.py` and use
# KEITARO_URL=http://127.0.0.1:8099 with KEITARO_API_KEY=demo-key.
KEITARO_URL=https://keitaro.example.com

# Admin API key. In Keitaro: Maintenance -> Users -> Admin API keys.
KEITARO_API_KEY=

# The app's own database. By default a SQLite file next to the project.
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/keitaro_manager
DATABASE_URL=sqlite:///./keitaro_manager.db

# Where flow 1 sends visitors from the selected countries.
GEO_REDIRECT_URL=https://google.com
