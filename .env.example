# Скопируйте этот файл в .env и подставьте свои значения.

# Адрес трекера Keitaro. Хвост /admin_api/v1 можно оставить или убрать, приложение поймёт оба варианта.
KEITARO_URL=https://keitaro-for-tests.etolegko.com

# Ключ Admin API. В Keitaro: Обслуживание → Пользователи → ключи Admin API. На учебном стенде: кнопка «API ключ» вверху.
KEITARO_API_KEY=

# База данных приложения. По умолчанию файл SQLite рядом с проектом.
# Для PostgreSQL: postgresql+psycopg://user:password@localhost:5432/keitaro_manager
DATABASE_URL=sqlite:///./keitaro_manager.db

# Куда первый поток отправляет посетителей из выбранных стран.
GEO_REDIRECT_URL=https://google.com
